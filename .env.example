# ==========================================
# Infravision Environment & Secrets Configuration
# ==========================================

# Development / Hot Reload Mode
# When true: FastAPI runs with uvicorn --reload and frontend runs Vite HMR dev server
# When false: FastAPI runs in multi-worker production mode and frontend serves optimized production build
DEV_MODE=true

# PostgreSQL Database Configuration
POSTGRES_USER=infravision
POSTGRES_PASSWORD=infravision_secret_change_me
POSTGRES_DB=infravision
POSTGRES_PORT=5435

# Internal Database Connection String (used by backend container)
DATABASE_URL=postgresql+psycopg://infravision:infravision_secret_change_me@postgres:5432/infravision

# Host Exposed Ports (avoids collisions with existing services)
BACKEND_PORT=8003
FRONTEND_PORT=5173

# Host directory mounted into container for indexing codebases
HOST_WORKSPACE=..
STORYBOT_UI_PATH=../story_bot/frontend

# Optional LLM & Embedding Secrets
LLM_PROVIDER=mock
LLM_API_KEY=
